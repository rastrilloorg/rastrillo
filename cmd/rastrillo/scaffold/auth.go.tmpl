// Sign-in by emailed link, on ui's sign-in screen: nobody chooses or
// stores a password. docs/site/magic-links.md has the whole story.

const signinPage action.Path = "/signin"

// powAssets serves pow's scripts from the module, never a copy: a copy
// drifting from the Go verifier fails silently.
var powAssets = rastrillo.NewAssets(pow.Assets())

// startAuth builds sign-in, and sweeps spent challenges and expired
// links on the background group, which shutdown stops.
func (app *App) startAuth(
	group *background.Group, mailer mail.Sender,
) error {
	signins, guard, err := app.newAuth(mailer)
	if err != nil {
		return err
	}
	group.Loop(context.Background(), 10*time.Minute, func() {
		if err := guard.Sweep(time.Now()); err != nil {
			app.logger.Warn("sweep spent sign-in challenges", "err", err)
		}
		if err := signins.Sweep(time.Now()); err != nil {
			app.logger.Warn("sweep expired sign-in links", "err", err)
		}
	})
	app.auth = signins
	return nil
}

// newAuth puts a proof-of-work guard in front of sign-in, so a scripted
// flood of requests costs work and the mailer is no open relay.
func (app *App) newAuth(mailer mail.Sender) (*auth.Auth, *pow.Guard, error) {
	if signinPagesErr != nil {
		return nil, nil, signinPagesErr
	}
	key, err := instanceKey()
	if err != nil {
		return nil, nil, err
	}
	writer, err := app.database.G.DB()
	if err != nil {
		return nil, nil, err
	}
	guard, err := newGuard(writer, key)
	if err != nil {
		return nil, nil, err
	}
	signins, err := auth.New(auth.Config{
		DB: writer, Origin: app.origin, InstanceKey: key, Proof: guard,
		Mailer: mailer, SigninPath: string(signinPage), SigninScreen: true,
		// No keymail partners: every address gets a link, and no server
		// is dialed, such as one an anonymous visitor's domain names.
		KeymailServers: []string{},
		// A link opens the sign-in screen with a button, so a mail
		// scanner that fetches the link spends nothing.
		RenderConfirm: func(response http.ResponseWriter,
			request *http.Request, _ auth.ConfirmPageData) {
			app.signinScreen(response, request)
		},
	})
	return signins, guard, err
}

// instanceKey seals challenges and pending sign-ins: CARLOS's key, else
// the variable's, else a random one for this run. Never a fixed key:
// anyone who reads it can forge a sign-in.
func instanceKey() (string, error) {
	const variable = "__ENV___INSTANCE_KEY"
	key, err := carlos.InstanceKey(os.Getenv(variable))
	if errors.Is(err, carlos.ErrNotOnCarlos) {
		return randomKey()
	}
	return key, err // ErrNoInstanceKey: on CARLOS with no key, never start
}

func newGuard(writer *sql.DB, key string) (*pow.Guard, error) {
	return pow.New(pow.Config{
		InstanceKey: key, Nonces: pow.SQLNonces(writer),
		// 16 bits keeps the p95 solve under a second on a slow phone.
		Difficulty: 16, MinAge: 500 * time.Millisecond,
		ScriptURL: "/pow" + powAssets.Path("pow.js"),
		WorkerURL: "/pow" + powAssets.Path("pow-worker.js"),
	})
}

// mountAuth registers sign-in. Verify answers GET and POST: GET draws
// the button and spends nothing, POST redeems the link.
func (app *App) mountAuth(routes *action.Routes) {
	signins := app.auth
	routes.Handle("GET", signinPage, http.HandlerFunc(app.signinScreen),
		"signinScreen")
	routes.Handle("POST", signinPage, http.HandlerFunc(signins.Begin),
		"beginSignin")
	routes.Handle("POST", "/signin/forget", http.HandlerFunc(signins.Forget),
		"forgetAddress")
	routes.Handle("GET", "/auth/callback",
		http.HandlerFunc(signins.Callback), "keymailCallback")
	routes.Handle("GET", "/auth/verify", http.HandlerFunc(signins.Verify),
		"showLink")
	routes.Handle("POST", "/auth/verify", http.HandlerFunc(signins.Verify),
		"redeemLink")
	routes.Handle("POST", "/signout", http.HandlerFunc(signins.Signout),
		"signout")
	routes.Mount("/pow", http.StripPrefix("/pow/", powAssets.Handler()),
		"pow")
}

// signinPages draws the sign-in screen on the stage shell, a set of its
// own because the rest of the app uses layout.html.
var signinPages, signinPagesErr = newSigninPages()

func newSigninPages() (*ui.Pages, error) {
	config, err := locales.CheckConfig(
		genlocales.DefaultLocale, genlocales.Locales)
	if err != nil {
		return nil, err
	}
	signin := ui.PageFile{Path: "templates/signin.html"}
	return ui.NewPages(ui.PagesConfig{
		App: appFS, Layout: "templates/stage.html",
		Pages: map[string]ui.PageFile{"signin": signin}, Locale: config,
		Funcs: template.FuncMap{"icon": icons.Icon, "iconAssets": icons.Assets,
			"asset": assets.Path},
	})
}

func (app *App) signinScreen(
	response http.ResponseWriter, request *http.Request,
) {
	state := app.auth.SigninState(request)
	app.auth.PrepareSigninResponse(response, state)
	err := signinPages.Execute(response, "signin", map[string]any{
		"L":      signinPages.LocalizerFor(request),
		"Scheme": rastrillo.SchemeFrom(request),
		"Signin": state,
		"Brand":  map[string]any{"Name": "__NAME__"},
	})
	if err != nil {
		http.Error(response, "Something went wrong.",
			http.StatusInternalServerError)
	}
}

type signedInKey struct{}

// signedIn marks a signed-in visitor's request, so every page can offer
// Sign out. It blocks nothing: owned pages sit behind RequireSession.
func (app *App) signedIn(next http.Handler) http.Handler {
	return http.HandlerFunc(func(response http.ResponseWriter,
		request *http.Request) {
		if _, ok := app.auth.SessionFrom(request); ok {
			request = request.WithContext(context.WithValue(
				request.Context(), signedInKey{}, true))
		}
		next.ServeHTTP(response, request)
	})
}

// ownerOf is the signed-in address exactly as auth gives it; set Owner
// from it. Never lowercase it: the part before @ can be case-sensitive.
func ownerOf(request *http.Request) string {
	identity, _ := auth.From(request)
	return identity.Address
}

// owned scopes every read and write of an owned row to its owner. In a
// transaction, scope its tx instead: owned there waits on the writer.
func (app *App) owned(request *http.Request) *gorm.DB {
	return scope.OwnedBy(app.database.G, "owner", ownerOf(request))
}

func randomKey() (string, error) {
	key := make([]byte, 32)
	if _, err := rand.Read(key); err != nil {
		return "", err
	}
	return hex.EncodeToString(key), nil
}

// account is the example owned page: it counts the visitor's notes
// through owned. Replace it with the app's own.
func (app *App) account(visit *action.Visit) {
	identity, _ := auth.From(visit.Request())
	var notes int64
	err := app.owned(visit.Request()).Model(&Note{}).Count(&notes).Error
	if visit.Refused(err) {
		return
	}
	visit.Render("index", http.StatusOK, map[string]any{
		"Address": identity.Address, "Notes": notes,
	})
}
