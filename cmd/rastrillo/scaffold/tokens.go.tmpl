package %[1]s

import (
	"net/http"
	"time"

	"amadan.net/rastrillo/rastrillo/action"
	"amadan.net/rastrillo/rastrillo/apitoken"
	"amadan.net/rastrillo/rastrillo/db"
	"amadan.net/rastrillo/rastrillo/sessions"
)

const tokensPage action.Path = "/tokens"

// TokenPage is where a person makes an API token for an agent or a
// script, sees it once, and revokes it. It needs sign-in, which a new
// app does not have yet; AGENTS.md says how to mount it.
type TokenPage struct {
	handlers *apitoken.Handlers
	sessions *sessions.Sessions
}

func NewTokenPage(
	database *db.DB, sessions *sessions.Sessions,
) (TokenPage, error) {
	store, err := newTokens(database)
	if err != nil {
		return TokenPage{}, err
	}
	handlers, err := apitoken.NewHandlers(apitoken.HandlersConfig{
		Store: store, Path: string(tokensPage), Render: renderTokens,
	})
	return TokenPage{handlers: handlers, sessions: sessions}, err
}

// Mount registers the page behind sign-in.
func (page TokenPage) Mount(routes *action.Routes) {
	handlers := page.handlers
	routes.Group(func(signedIn *action.Routes) {
		signedIn.Guard("session", page.sessions.Require)
		signedIn.Handle("GET", tokensPage,
			http.HandlerFunc(handlers.Page), "tokenPage")
		// A token outlives its session, so making one needs a sign-in
		// in the last ten minutes. Revoking one stays easy.
		signedIn.Group(func(fresh *action.Routes) {
			fresh.Guard("fresh", page.sessions.RequireFresh(10*time.Minute))
			fresh.Handle("POST", tokensPage,
				http.HandlerFunc(handlers.Create), "createToken")
		})
		signedIn.Handle("POST", "/tokens/revoke",
			http.HandlerFunc(handlers.Revoke), "revokeToken")
		signedIn.Handle("POST", "/tokens/revoke-agent",
			http.HandlerFunc(handlers.RevokeAgent), "revokeAgentTokens")
		signedIn.Handle("POST", "/tokens/revoke-all",
			http.HandlerFunc(handlers.RevokeAll), "revokeAllTokens")
	})
}

func renderTokens(
	response http.ResponseWriter, request *http.Request,
	data apitoken.PageData,
) {
	renderPage(response, request, "tokens", http.StatusOK,
		map[string]any{"Page": data})
}
