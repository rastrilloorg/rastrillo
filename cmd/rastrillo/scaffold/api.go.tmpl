package %[1]s

import (
	"context"
	"log/slog"
	"net/http"

	"amadan.net/rastrillo/rastrillo"
	"amadan.net/rastrillo/rastrillo/api"
	"amadan.net/rastrillo/rastrillo/apitoken"
	"amadan.net/rastrillo/rastrillo/db"
	"amadan.net/rastrillo/rastrillo/mcp"
	"amadan.net/rastrillo/rastrillo/op"

	"%[2]s/gen"
)

// tokenPrefix starts every token this app makes, so a secret scanner
// knows a leaked one. Changing it voids every token already given out.
const tokenPrefix = %[3]q

// newDoors builds the JSON API and MCP from one config, so they cannot
// differ. A new app exposes no operations: the API answers 404.
func newDoors(
	database *db.DB, logger *slog.Logger,
) (tree, tools http.Handler, err error) {
	tokens, err := newTokens(database)
	if err != nil {
		return nil, nil, err
	}
	config := api.Config{
		Verify: tokens,
		// Actor stays zero: the API fills it from the token.
		Ctx: func(*http.Request) *rastrillo.Ctx {
			return &rastrillo.Ctx{DB: database.Writer(), Logger: logger,
				Authorize: authorize}
		},
		Authorize: authorize,
		Logger:    logger,
		Redact:    tokens.Redact,
	}
	tree, err = api.New(config, gen.APIRoutes()...)
	if err != nil {
		return nil, nil, err
	}
	tools, err = mcp.New(mcp.Config{
		Gate:      config.Gate(),
		Ctx:       config.Ctx,
		Authorize: config.Authorize,
		Name:      %[2]q,
		Version:   rastrillo.BuildVersion,
	}, gen.ExposedOperations()...)
	return tree, tools, err
}

// authorize is the one policy for the pages and the API. The API cannot
// see page middleware, so a rule a page adds goes here too.
func authorize(
	ctx context.Context, actor rastrillo.Actor, operation rastrillo.Operation,
) error {
	return op.DefaultPolicy(ctx, actor, operation)
}

// newTokens is the one store, so the page and the API share a prefix.
func newTokens(database *db.DB) (*apitoken.Store, error) {
	return apitoken.New(apitoken.Config{
		DB: database.Writer(), Prefix: tokenPrefix,
	})
}
