//go:build perf

package %[2]stest

import (
	"io"
	"log/slog"
	"net/http"
	"testing"
	"time"

	"amadan.net/rastrillo/rastrillo"
	"amadan.net/rastrillo/rastrillo/db"
	"amadan.net/rastrillo/rastrillo/perf/perftest"

	genlocales "%[1]s/gen/locales"
	"%[1]s/internal/%[2]s"
)

// Every GET screen is held to 150ms to first byte: a new route fails here
// until it is measured or recorded in .rastrillo/budgets.txt. Never
// t.Parallel() in this file: a perf test measures its neighbours.
func TestPerfScreens(t *testing.T) {
	logger := slog.New(slog.NewTextHandler(io.Discard, nil))
	database, err := db.Open(schema.Path(t), logger)
	if err != nil {
		t.Fatal(err)
	}
	defer database.Close()
	router, err := %[2]s.Router(
		database, testOrigin, logger)
	if err != nil {
		t.Fatal(err)
	}
	mux := http.NewServeMux()
	mux.Handle("/", router)
	options := servingOptions(logger)
	%[2]s.Configure(&options, mux, time.Now())
	handler, closeAll, err := rastrillo.Handler(options)
	if err != nil {
		t.Fatal(err)
	}
	defer closeAll()
	perftest.Screens(t, perftest.ScreenConfig{Routes: router, Handler: handler})
}

// A cold start, from exec to the first byte of "/", held to 500ms.
func TestPerfBoot(t *testing.T) {
	perftest.Boot(t, perftest.BootConfig{
		Prepare: schema.Path,
		Build:   boot,
		Path:    "/",
	})
}

func boot(path string) (http.Handler, func(), error) {
	started := time.Now()
	logger := slog.New(slog.NewTextHandler(io.Discard, nil))
	database, err := db.Open(path, logger)
	if err != nil {
		return nil, nil, err
	}
	mux, err := %[2]s.New(
		database, testOrigin, logger)
	if err != nil {
		database.Close()
		return nil, nil, err
	}
	options := servingOptions(logger)
	%[2]s.Configure(&options, mux, started)
	handler, closeAll, err := rastrillo.Handler(options)
	if err != nil {
		database.Close()
		return nil, nil, err
	}
	return handler, func() { closeAll(); database.Close() }, nil
}

// servingOptions are main.go's, so the lane measures what is served.
func servingOptions(logger *slog.Logger) rastrillo.Options {
	return rastrillo.Options{Logger: logger, Locales: genlocales.Locales,
		DefaultLocale: genlocales.DefaultLocale}
}
