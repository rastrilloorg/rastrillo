package %[2]s_test

import (
	"context"
	"strings"
	"testing"

	"amadan.net/rastrillo/rastrillo/migrate/modeldiff"

	%[2]s "%[1]s/internal/%[2]s"
)

// TestModelsMatchMigrations is the migration check, run by go test: it
// replays Schema into an in-memory database and diffs the result
// against Models, as rastrillo migration check does. A model changed
// without its migration fails here, not at the first query that needs
// the new column on a real database.
func TestModelsMatchMigrations(t *testing.T) {
	t.Parallel()
	changes, err := modeldiff.Generate(context.Background(), %[2]s.Schema.All(), %[2]s.Models)
	if err != nil {
		t.Fatal(err)
	}
	if len(changes) == 0 {
		return
	}
	var b strings.Builder
	b.WriteString("models and migrations disagree:\n")
	for _, c := range changes {
		b.WriteString("  " + strings.TrimSpace(c.SQL) + "\n")
	}
	b.WriteString("\nrun: rastrillo migration generate")
	t.Fatal(b.String())
}
