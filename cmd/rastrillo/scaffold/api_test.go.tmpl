// The API answers at /api/v1 and below it in JSON. A new app exposes
// nothing, so the answer is the API's own 404.
func TestAPIAnswersInJSON(t *testing.T) {
	t.Parallel()
	handler := newApp(t)
	for _, path := range []string{"/api/v1", "/api/v1/notes"} {
		recorder := get(t, handler, path)
		var answer struct{ Error struct{ Code string } }
		err := json.Unmarshal(recorder.Body.Bytes(), &answer)
		if recorder.Code != http.StatusNotFound ||
			err != nil || answer.Error.Code != "not_found" {
			t.Errorf("GET %%s: %%d, not the API's JSON 404 (%%v):\n%%s",
				path, recorder.Code, err, recorder.Body.String())
		}
		if got := recorder.Header().Get("Cache-Control"); got != "no-store" {
			t.Errorf("GET %%s: Cache-Control = %%q, want no-store", path, got)
		}
	}
}

// tokenPattern is a whole token with this app's prefix.
var tokenPattern = regexp.MustCompile(
	`\b%[3]s_([0-9A-Za-z]{12})_[0-9A-Za-z]{43}\b`)

// The token page shows a new token once, and afterwards lists it by its
// public ID alone.
func TestTokenPageShowsANewTokenOnce(t *testing.T) {
	t.Parallel()
	send := signedInTokenPage(t)
	catalog := rastrillo.BaseCatalogs()[genlocales.DefaultLocale]
	title := template.HTMLEscapeString(catalog["rastrillo.ui.api_tokens_title"])
	recorder := send(http.MethodGet, nil)
	if recorder.Code != http.StatusOK ||
		!strings.Contains(recorder.Body.String(), title) {
		t.Fatalf("GET /tokens: %%d, want 200 and the title:\n%%s",
			recorder.Code, recorder.Body.String())
	}
	recorder = send(http.MethodPost, url.Values{"agent": {"Claude"},
		"access": {"write"}, "expiry": {"90"}})
	token := tokenPattern.FindStringSubmatch(recorder.Body.String())
	if recorder.Code != http.StatusOK || token == nil {
		t.Fatalf("POST /tokens: %%d, want 200 and the new token:\n%%s",
			recorder.Code, recorder.Body.String())
	}
	if got := recorder.Header().Get("Cache-Control"); got != "no-store" {
		t.Errorf("POST /tokens: Cache-Control = %%q, want no-store", got)
	}
	body := send(http.MethodGet, nil).Body.String()
	if strings.Contains(body, token[0]) || !strings.Contains(body, token[1]) {
		t.Errorf("GET /tokens after: want %%s listed and the secret gone:\n%%s",
			token[1], body)
	}
}

// signedInTokenPage serves the page to a signed-in person. A new app has no
// sign-in, so this brings the sessions table and a session of its own.
func signedInTokenPage(
	t *testing.T,
) func(method string, form url.Values) *httptest.ResponseRecorder {
	database, signins := signinStore(t)
	cookie, err := signins.Mint(sessions.Session{Subject: "1"})
	if err != nil {
		t.Fatal(err)
	}
	page, err := %[2]s.NewTokenPage(database, signins)
	if err != nil {
		t.Fatal(err)
	}
	router := chi.NewRouter()
	routes := action.NewRoutes(router, nil)
	routes.Guard("csrf", csrf.Protect(testOrigin))
	page.Mount(routes)
	return func(method string, form url.Values) *httptest.ResponseRecorder {
		request := httptest.NewRequest(method, "/tokens",
			strings.NewReader(form.Encode()))
		request.Header.Set("Content-Type", "application/x-www-form-urlencoded")
		request.Header.Set("Origin", testOrigin)
		request.AddCookie(&http.Cookie{Name: signins.CookieName(),
			Value: cookie})
		recorder := httptest.NewRecorder()
		router.ServeHTTP(recorder, request)
		return recorder
	}
}

func signinStore(t *testing.T) (*db.DB, *sessions.Sessions) {
	t.Helper()
	logger := slog.New(slog.NewTextHandler(io.Discard, nil))
	database, err := db.Open(schema.Path(t), logger)
	if err != nil {
		t.Fatalf("db.Open: %%v", err)
	}
	t.Cleanup(func() { database.Close() })
	ctx := context.Background()
	if _, err := migrate.Apply(ctx, database, sessions.Schema); err != nil {
		t.Fatal(err)
	}
	signins, err := sessions.New(sessions.Config{DB: database.Writer(),
		Origin: testOrigin, Logger: logger})
	if err != nil {
		t.Fatal(err)
	}
	return database, signins
}
